#executed as e-0-0-0-1 at @s

#offset based on the randomize offset we picked
execute if score #x_offset sab.var matches ..-91 run tp @s ~1 ~ ~
execute if score #x_offset sab.var matches -90..-81 run tp @s ~.9 ~ ~
execute if score #x_offset sab.var matches -80..-71 run tp @s ~.8 ~ ~
execute if score #x_offset sab.var matches -70..-61 run tp @s ~.7 ~ ~
execute if score #x_offset sab.var matches -60..-51 run tp @s ~.6 ~ ~
execute if score #x_offset sab.var matches -50..-41 run tp @s ~.5 ~ ~
execute if score #x_offset sab.var matches -40..-31 run tp @s ~.4 ~ ~
execute if score #x_offset sab.var matches -30..-21 run tp @s ~.3 ~ ~
execute if score #x_offset sab.var matches -20..-11 run tp @s ~.2 ~ ~
execute if score #x_offset sab.var matches -10..-1 run tp @s ~.1 ~ ~
#0 is 0
execute if score #x_offset sab.var matches 1..10 run tp @s ~-.1 ~ ~
execute if score #x_offset sab.var matches 11..20 run tp @s ~-.2 ~ ~
execute if score #x_offset sab.var matches 21..30 run tp @s ~-.3 ~ ~
execute if score #x_offset sab.var matches 31..40 run tp @s ~-.4 ~ ~
execute if score #x_offset sab.var matches 41..50 run tp @s ~-.5 ~ ~
execute if score #x_offset sab.var matches 51..60 run tp @s ~-.6 ~ ~
execute if score #x_offset sab.var matches 61..70 run tp @s ~-.7 ~ ~
execute if score #x_offset sab.var matches 71..80 run tp @s ~-.8 ~ ~
execute if score #x_offset sab.var matches 81..90 run tp @s ~-.9 ~ ~
execute if score #x_offset sab.var matches 91.. run tp @s ~-1 ~ ~